# Optional build-time configuration. Everything prefixed VITE_ is bundled into
# the public frontend and visible to anyone. Never put private credentials here.

# Use your own PeerJS server instead of the public 0.peerjs.com.
# Every laptop in a room must use the same server.
# VITE_PEER_HOST=peer.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true

# Public STUN/TURN entries only (JSON). Omit to keep PeerJS's defaults.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Keeps rooms from different deployments apart on a shared signaling server.
# Defaults to a hash of the site's host name.
# VITE_ROOM_NAMESPACE=trip-speaker-friends
